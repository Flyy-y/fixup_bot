# Copy to .env and fill in your real values. .env is git-ignored.
# Discord bot token (from the Developer Portal). NEVER commit the real value.
TOKEN=your-discord-bot-token-here

# Optional: only needed to run the local live smoke test (tests/smoke_test.py).
# SMOKE_CHANNEL_ID=123456789012345678

# Optional logging level (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
# LOG_LEVEL=INFO
